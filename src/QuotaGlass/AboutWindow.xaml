<Window x:Class="QuotaGlass.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaGlass 정보"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border Margin="12"
            Padding="22"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="이 프로그램에 대하여" />

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                <TextBlock Width="100"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           Text="프로그램 이름" />
                <TextBlock Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="QuotaGlass" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                <TextBlock Width="100"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           Text="버전" />
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="3"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                <TextBlock Width="100"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           Text="빌드 날짜" />
                <TextBlock x:Name="BuildDateText"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Grid.Row="4"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13">
                <Run Text="저장소  " />
                <Hyperlink x:Name="RepositoryLink"
                           Foreground="{DynamicResource SafeBrush}"
                           RequestNavigate="RepositoryLink_RequestNavigate">
                    https://github.com/jinjaeyeon/QuotaGlass
                </Hyperlink>
            </TextBlock>

            <Button Grid.Row="5"
                    Width="84"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Content="닫기" />
        </Grid>
    </Border>
</Window>
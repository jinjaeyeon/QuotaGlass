<Application x:Class="QuotaGlass.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F2161920" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF7F8FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8F7F8FA" />
        <SolidColorBrush x:Key="SafeBrush" Color="#FF78D6A3" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC56D" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF7185" />
        <SolidColorBrush x:Key="TrackBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ContextMenuBrush" Color="#FF1C2028" />
        <SolidColorBrush x:Key="WidgetBrush" Color="#FA161920" />
        <SolidColorBrush x:Key="IconSurfaceBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#28FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

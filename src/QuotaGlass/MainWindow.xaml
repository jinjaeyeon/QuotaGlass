<Window x:Class="QuotaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuotaGlass.Controls"
        Title="QuotaGlass"
        Icon="Assets/QuotaGlass.ico"
        Width="720"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="12"
            Padding="20"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              Direction="270"
                              Opacity="0.45"
                              ShadowDepth="8"
                              Color="#CC000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="QuotaGlass" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding UpdateSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Width="48"
                            Padding="10,6"
                            FontSize="16"
                            ToolTip="사용량 새로고침"
                            Command="{Binding RefreshCommand}"
                            Content="{Binding RefreshGlyph}" />
                    <Button Width="48"
                            Padding="10,6"
                            FontSize="16"
                            ToolTip="트레이로 숨기기"
                            Click="HideButton_Click"
                            Content="—" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Rectangle Width="16"
                               Height="8"
                               RadiusX="3"
                               RadiusY="3"
                               Fill="{StaticResource SafeBrush}" />
                    <TextBlock Margin="6,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="남은 사용량" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="◆" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="현재 시각의 안정권 기준" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource MutedTextBrush}"
                          Content="전체 제한"
                          IsChecked="{Binding ShowDetails}" />
            </Grid>

            <ScrollViewer Grid.Row="2"
                          MaxHeight="650"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,9"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.RowSpan="2"
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#20FFFFFF"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding IconText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource TextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="#16FFFFFF"
                                                CornerRadius="5">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="{Binding AccountLabel}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding PrimaryMeter.ResetText}" />

                                    <TextBlock Grid.RowSpan="2"
                                               Grid.Column="2"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding PrimaryMeter.RemainingText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <controls:PacedUsageBar Grid.Row="2"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="2"
                                                            Height="30"
                                                            Margin="0,10,0,0"
                                                            RemainingRatio="{Binding PrimaryMeter.RemainingRatio}"
                                                            SafeRemainingRatio="{Binding PrimaryMeter.SafeRemainingRatio}"
                                                            IsWarning="{Binding PrimaryMeter.IsWarning}">
                                        <controls:PacedUsageBar.Style>
                                            <Style TargetType="controls:PacedUsageBar">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:PacedUsageBar.Style>
                                    </controls:PacedUsageBar>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding PrimaryMeter.StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SafeBrush}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PrimaryMeter.IsWatch}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PrimaryMeter.IsWarning}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,12,0,2"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               Text="{Binding StatusMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl Grid.Row="4"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,9,0,0"
                                                  ItemsSource="{Binding SecondaryMeters}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="132" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,0,8,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Label}"
                                                               Text="{Binding Label}" />
                                                    <controls:PacedUsageBar Grid.Column="1"
                                                                            Height="26"
                                                                            Margin="0,0,10,0"
                                                                            RemainingRatio="{Binding RemainingRatio}"
                                                                            SafeRemainingRatio="{Binding SafeRemainingRatio}"
                                                                            IsWarning="{Binding IsWarning}" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Text="{Binding RemainingText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3"
                       HorizontalAlignment="Right"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       Text="경고 기준: 안정권보다 5％p 이상 빠른 소진" />
        </Grid>
    </Border>
</Window>

<Window x:Class="QuotaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuotaGlass.Controls"
        Title="QuotaGlass"
        Icon="Assets/QuotaGlass.ico"
        Width="720"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="12"
            Padding="20"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="QuotaGlass" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding UpdateSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Width="48"
                            Padding="10,6"
                            FontSize="16"
                            ToolTip="사용량 새로고침"
                            Command="{Binding RefreshCommand}"
                            Content="{Binding RefreshGlyph}" />
                    <Button Width="48"
                            Padding="10,6"
                            FontSize="16"
                            ToolTip="트레이로 숨기기"
                            Click="HideButton_Click"
                            Content="—" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Rectangle Width="16"
                               Height="8"
                               RadiusX="3"
                               RadiusY="3"
                               Fill="{DynamicResource SafeBrush}" />
                    <TextBlock Margin="6,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Text="남은 사용량" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="◆" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Text="현재 시각의 안정권 기준" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource MutedTextBrush}"
                          Content="전체 제한"
                          IsChecked="{Binding ShowDetails}" />
            </Grid>

            <ScrollViewer Grid.Row="2"
                          MaxHeight="650"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource GlassVerticalScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding VisibleProviders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,9"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.RowSpan="2"
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource IconSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <Grid Margin="7">
                                            <Path Data="{Binding IconGeometry}"
                                                  Fill="{DynamicResource TextBrush}"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding IconText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource BadgeBrush}"
                                                CornerRadius="5">
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="{Binding AccountLabel}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding PrimaryMeter.ResetText}" />

                                    <Button Grid.Column="2"
                                            Padding="8,3"
                                            Margin="18,0,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="10"
                                            ToolTip="메인 창에서 이 에이전트 접기"
                                            Click="CollapseProviderButton_Click"
                                            Content="접기" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding PrimaryMeter.RemainingText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <controls:PacedUsageBar Grid.Row="2"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="2"
                                                            Height="30"
                                                            Margin="0,10,0,0"
                                                            RemainingRatio="{Binding PrimaryMeter.RemainingRatio}"
                                                            SafeRemainingRatio="{Binding PrimaryMeter.SafeRemainingRatio}"
                                                            IsWarning="{Binding PrimaryMeter.IsWarning}"
                                                            TrackBrush="{DynamicResource TrackBrush}"
                                                            SafeBrush="{DynamicResource SafeBrush}"
                                                            WarningBrush="{DynamicResource DangerBrush}"
                                                            MarkerBrush="{DynamicResource TextBrush}">
                                        <controls:PacedUsageBar.Style>
                                            <Style TargetType="controls:PacedUsageBar">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:PacedUsageBar.Style>
                                    </controls:PacedUsageBar>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding PrimaryMeter.StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource SafeBrush}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PrimaryMeter.IsWatch}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PrimaryMeter.IsWarning}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,12,0,2"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               Text="{Binding StatusMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUsage}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl Grid.Row="4"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,9,0,0"
                                                  ItemsSource="{Binding SecondaryMeters}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,0,8,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ResetText}"
                                                               Text="{Binding ResetText}" />
                                                    <controls:PacedUsageBar Grid.Column="1"
                                                                            Height="26"
                                                                            Margin="0,0,10,0"
                                                                            RemainingRatio="{Binding RemainingRatio}"
                                                                            SafeRemainingRatio="{Binding SafeRemainingRatio}"
                                                                            IsWarning="{Binding IsWarning}"
                                                                            TrackBrush="{DynamicResource TrackBrush}"
                                                                            SafeBrush="{DynamicResource SafeBrush}"
                                                                            WarningBrush="{DynamicResource DangerBrush}"
                                                                            MarkerBrush="{DynamicResource TextBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Text="{Binding RemainingText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,1,0,9"
                            Padding="12,10"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManagedCliOptions.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Margin="2,0,0,7"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="QuotaGlass 전용 CLI · 시스템 PATH는 변경하지 않음" />
                            <ItemsControl ItemsSource="{Binding ManagedCliOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Status}"
                                                       Text="{Binding Status}" />
                                            <Button Grid.Column="2"
                                                    MinWidth="88"
                                                    Padding="8,4"
                                                    FontSize="10"
                                                    Command="{Binding ActionCommand}"
                                                    Content="{Binding ActionText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,1,0,9"
                            Padding="12,10"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CollapsedProviders.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Margin="2,0,0,7"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="접은 에이전트 · 클릭해서 다시 열기" />
                        <ItemsControl ItemsSource="{Binding CollapsedProviders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,7,4"
                                            Padding="9,5"
                                            FontSize="11"
                                            ToolTip="다시 펼치기"
                                            Click="ExpandProviderButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="＋" />
                                            <TextBlock Margin="4,0,0,0"
                                                       Text="{Binding DisplayName}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="3"
                       HorizontalAlignment="Right"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10"
                       Text="경고 기준: 안정권보다 5％p 이상 빠른 소진" />
        </Grid>
    </Border>
</Window>

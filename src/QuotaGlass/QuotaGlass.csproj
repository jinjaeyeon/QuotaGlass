<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuotaGlass</RootNamespace>
    <AssemblyName>QuotaGlass</AssemblyName>
    <ApplicationIcon>Assets\QuotaGlass.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\QuotaGlass.ico" />
    <InternalsVisibleTo Include="QuotaGlass.SmokeTests" />
  </ItemGroup>
</Project>

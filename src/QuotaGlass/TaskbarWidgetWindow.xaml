<Window x:Class="QuotaGlass.TaskbarWidgetWindow"
        x:Name="WidgetRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaGlass 작업표시줄 사용량"
        Icon="Assets/QuotaGlass.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CompactUsageBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SafeBrush}" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track"
                                  ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWatch}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10"
                                Padding="5"
                                Background="{DynamicResource ContextMenuBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Margin="0,1"
                                Padding="9,7"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Icon" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetMenuSeparatorStyle"
               TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="9,5"
                                Background="{DynamicResource SeparatorBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetChrome"
            MinWidth="68"
            Height="38"
            Padding="7,4"
            Background="{DynamicResource WidgetBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Cursor="SizeWE"
            MouseLeftButtonDown="WidgetChrome_MouseLeftButtonDown"
            MouseMove="WidgetChrome_MouseMove"
            MouseLeftButtonUp="WidgetChrome_MouseLeftButtonUp"
            ToolTip="클릭: 전체 보기 · 드래그: 작업표시줄 안에서 이동">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu"
                         Style="{StaticResource WidgetContextMenuStyle}"
                         Opened="WidgetContextMenu_Opened"
                         Closed="WidgetContextMenu_Closed">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource WidgetMenuItemStyle}" />
                    <Style TargetType="Separator"
                           BasedOn="{StaticResource WidgetMenuSeparatorStyle}" />
                </ContextMenu.Resources>
                <MenuItem Header="전체 창 열기"
                          Click="OpenFullWindowMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="↗" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="새로고침"
                          Click="RefreshMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="↻" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ProviderVisibilityHeading"
                          Header="위젯 표시 항목"
                          IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="◉" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="위젯 위치 초기화"
                          Click="ResetPlacementMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="⌖" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StartWithWindowsMenuItem"
                          Header="Windows 시작 시 자동 실행"
                          IsCheckable="True"
                          StaysOpenOnClick="True"
                          Click="StartWithWindowsMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock x:Name="StartWithWindowsCheckGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="테마"
                          IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="◐" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="LightThemeMenuItem"
                          Header="Light"
                          IsCheckable="True"
                          Click="LightThemeMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock x:Name="LightThemeCheckGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="DarkThemeMenuItem"
                          Header="Dark"
                          IsCheckable="True"
                          Click="DarkThemeMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock x:Name="DarkThemeCheckGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="SystemThemeMenuItem"
                          Header="시스템"
                          IsCheckable="True"
                          Click="SystemThemeMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock x:Name="SystemThemeCheckGlyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="종료"
                          Foreground="{DynamicResource DangerBrush}"
                          Click="ExitMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="⏻" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <ItemsControl ItemsSource="{Binding WidgetProviders, ElementName=WidgetRoot}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WidgetProviders.Count, ElementName=WidgetRoot}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="132"
                              Height="28"
                              Margin="0,0,8,0"
                              ToolTip="{Binding CompactToolTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource IconSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                <Grid Margin="4">
                                    <Path Data="{Binding IconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding IconText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding CompactMeters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding CompactLabel}" />
                                            <ProgressBar Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource CompactUsageBarStyle}"
                                                         Value="{Binding RemainingRatio, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       Text="확인 중…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUsage}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WidgetProviders.Count, ElementName=WidgetRoot}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Foreground="{DynamicResource TextBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="QG" />
                <TextBlock Margin="5,0,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           Text="…" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

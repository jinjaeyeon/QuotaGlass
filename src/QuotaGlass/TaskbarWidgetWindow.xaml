<Window x:Class="QuotaGlass.TaskbarWidgetWindow"
        x:Name="WidgetRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuotaGlass.Controls"
        Title="QuotaGlass 작업표시줄 사용량"
        Icon="Assets/QuotaGlass.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CompactUsageBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SafeBrush}" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track"
                                  ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWatch}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactMeterTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#FFF7F8FA" />
            <Setter Property="FontSize"
                    Value="9" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2"
                                      Color="#FF000000"
                                      Opacity="1"
                                      ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="HorizontalWidgetProvidersPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalWidgetProvidersPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <Style x:Key="WidgetContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10"
                                Padding="5"
                                Background="{DynamicResource ContextMenuBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemChrome"
                                    Margin="0,1"
                                    Padding="9,7"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Icon" />
                                    <ContentPresenter Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="16"
                                               Text="›"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="SubMenuPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade"
                                   StaysOpen="True">
                                <Border Margin="5"
                                        Padding="5"
                                        Background="{DynamicResource ContextMenuBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemChrome"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetMenuSeparatorStyle"
               TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="9,5"
                                Background="{DynamicResource SeparatorBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetChrome"
            MinWidth="68"
            Height="44"
            Padding="7,4"
            Background="{DynamicResource WidgetBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Cursor="SizeWE"
            MouseLeftButtonDown="WidgetChrome_MouseLeftButtonDown"
            MouseMove="WidgetChrome_MouseMove"
            MouseLeftButtonUp="WidgetChrome_MouseLeftButtonUp"
            ToolTip="클릭: 전체 보기 · 드래그: 설정에 따라 이동">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu"
                         Style="{StaticResource WidgetContextMenuStyle}"
                         Opened="WidgetContextMenu_Opened"
                         Closed="WidgetContextMenu_Closed">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource WidgetMenuItemStyle}" />
                    <Style TargetType="Separator"
                           BasedOn="{StaticResource WidgetMenuSeparatorStyle}" />
                </ContextMenu.Resources>
                <MenuItem x:Name="AppVersionMenuItem"
                          Header="QuotaGlass"
                          IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="ⓘ" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="전체 창 열기"
                          Click="OpenFullWindowMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="↗" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="새로고침"
                          Click="RefreshMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="↻" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CheckForUpdatesMenuItem"
                          Header="업데이트 확인"
                          Click="CheckForUpdatesMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="⟳" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ProviderVisibilityMenuItem"
                          Header="위젯 표시 항목">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="◉" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="SystemResourceMetricsMenuItem"
                              Header="CPU/메모리 그래프 표시"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="SystemResourceMetricsMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="SystemResourceMetricsCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="WidgetAppearanceMenuItem"
                          Header="위젯 모양">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="◌" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="WidgetTransparency0MenuItem"
                              Header="투명도 0% (불투명)"
                              Tag="0"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="WidgetTransparencyMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="WidgetTransparency0CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="WidgetTransparency25MenuItem"
                              Header="투명도 25%"
                              Tag="25"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="WidgetTransparencyMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="WidgetTransparency25CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="WidgetTransparency50MenuItem"
                              Header="투명도 50%"
                              Tag="50"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="WidgetTransparencyMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="WidgetTransparency50CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="WidgetTransparency75MenuItem"
                              Header="투명도 75%"
                              Tag="75"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="WidgetTransparencyMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="WidgetTransparency75CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="WidgetBackgroundMenuItem"
                              Header="위젯 배경 표시"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="WidgetBackgroundMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="WidgetBackgroundCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="AntiAliasingMenuItem"
                              Header="안티앨리어싱 사용"
                              IsCheckable="False"
                              StaysOpenOnClick="True"
                              Click="AntiAliasingMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="AntiAliasingCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator x:Name="UpdateMenuSeparator"
                           Visibility="Collapsed" />
                <MenuItem x:Name="UpdateMenuItem"
                          Header="업데이트"
                          Visibility="Collapsed"
                          Click="UpdateMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="↓" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="WidgetLayoutMenuItem"
                          Header="위젯 배치">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="⌖" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="FreeMovementMenuItem"
                              Header="화면 전체에서 자유롭게 이동"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="FreeMovementMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="FreeMovementCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="VerticalLayoutMenuItem"
                              Header="그래프 세로로 배치"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="VerticalLayoutMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="VerticalLayoutCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="위젯 위치 초기화"
                              Click="ResetPlacementMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Text="⌖" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="AppSettingsMenuItem"
                          Header="앱 설정">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="⚙" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="StartWithWindowsMenuItem"
                              Header="Windows 시작 시 자동 실행"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              Click="StartWithWindowsMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="StartWithWindowsCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="ThemeMenuItem"
                          Header="테마">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="◐" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="LightThemeMenuItem"
                              Header="Light"
                              IsCheckable="True"
                              Click="LightThemeMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="LightThemeCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="DarkThemeMenuItem"
                              Header="Dark"
                              IsCheckable="True"
                              Click="DarkThemeMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="DarkThemeCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="SystemThemeMenuItem"
                              Header="시스템"
                              IsCheckable="True"
                              Click="SystemThemeMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock x:Name="SystemThemeCheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="종료"
                          Foreground="{DynamicResource DangerBrush}"
                          Click="ExitMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="⏻" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <StackPanel x:Name="WidgetContentPanel"
                        Orientation="Horizontal">
                <ItemsControl x:Name="WidgetProvidersControl"
                              ItemsSource="{Binding WidgetProviders, ElementName=WidgetRoot}"
                              ItemsPanel="{StaticResource HorizontalWidgetProvidersPanel}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WidgetProviders.Count, ElementName=WidgetRoot}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="120"
                              Height="34"
                              ToolTip="{Binding CompactToolTip}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin"
                                            Value="0,0,8,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVerticalLayout, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="True">
                                            <Setter Property="Margin"
                                                    Value="0,0,0,5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource IconSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                <Grid Margin="4">
                                    <Path Data="{Binding IconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding IconText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVectorIcon}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding CompactMeters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="17">
                                            <ProgressBar Height="15"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource CompactUsageBarStyle}"
                                                         Value="{Binding RemainingRatio, Mode=OneWay}" />
                                            <Grid Margin="6,0"
                                                  IsHitTestVisible="False">
                                                <TextBlock HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CompactMeterTextStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding CompactLabel}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CompactMeterTextStyle}"
                                                           Text="{Binding CompactRemainingText}" />
                                            </Grid>
                                            <controls:CompactUsageMarker Height="17"
                                                                         Panel.ZIndex="1"
                                                                         VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"
                                                                         PositionRatio="{Binding SafeRemainingRatio}"
                                                                         IsWarning="{Binding IsWarning}"
                                                                         MarkerBrush="{DynamicResource TextBrush}"
                                                                         WarningBrush="{DynamicResource DangerBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       Text="확인 중…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUsage}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="ResourceMetricsPanel"
                            Margin="0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Border x:Name="ResourceMetricsBorder"
                            Width="86"
                            Height="34"
                            VerticalAlignment="Center"
                            Padding="5,2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ToolTip="{Binding SystemResources.ResourceToolTip, ElementName=WidgetRoot}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin"
                                        Value="0,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerticalLayout, ElementName=WidgetRoot}"
                                                 Value="True">
                                        <Setter Property="Margin"
                                                Value="0,0,0,5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource SafeBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Text="C" />
                                    <TextBlock Margin="1,0,0,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Text="{Binding SystemResources.CpuUsageText, ElementName=WidgetRoot}" />
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource WarningBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Text="M" />
                                    <TextBlock Margin="1,0,0,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Text="{Binding SystemResources.MemoryUsageText, ElementName=WidgetRoot}" />
                                </StackPanel>
                            </StackPanel>
                            <controls:UsageSparkline Grid.Row="1"
                                                     Margin="0,1,0,0"
                                                     BaselineBrush="{DynamicResource TrackBrush}"
                                                     IsHitTestVisible="False"
                                                     SecondaryStroke="{DynamicResource WarningBrush}"
                                                     SecondaryValues="{Binding SystemResources.MemoryHistory, ElementName=WidgetRoot}"
                                                     Stroke="{DynamicResource SafeBrush}"
                                                     StrokeThickness="1.4"
                                                     Values="{Binding SystemResources.CpuHistory, ElementName=WidgetRoot}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border x:Name="UpdateStatusBanner"
                    Padding="9,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ContextMenuBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SafeBrush}"
                               FontSize="13"
                               Text="↓" />
                    <TextBlock x:Name="UpdateStatusTextBlock"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="업데이트 중…" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
